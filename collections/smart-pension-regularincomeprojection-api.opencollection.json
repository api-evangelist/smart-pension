{
  "opencollection": "1.0.0",
  "info": {
    "name": "Keystone Regular Income Projection API",
    "version": "v12"
  },
  "items": [
    {
      "info": {
        "name": "RegularIncomeProjection",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "RegularIncomeProjection/Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.autoenrolment.co.uk/companies/:company_id/employees/:employee_id/regular_income_projection",
            "params": [
              {
                "name": "company_id",
                "value": "843",
                "type": "path"
              },
              {
                "name": "employee_id",
                "value": "443",
                "type": "path"
              },
              {
                "name": "regular_income_amount",
                "value": "regular_income_amount=100",
                "type": "query"
              },
              {
                "name": "regular_income_end_age",
                "value": "regular_income_end_age=80",
                "type": "query"
              },
              {
                "name": "total_amount",
                "value": "total_amount=100",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://id.sandbox.autoenrolment.co.uk/oauth/authorize",
              "accessTokenUrl": "https://id.sandbox.autoenrolment.co.uk/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "RegularIncomeProjection/Get"
        }
      ]
    }
  ],
  "bundled": true
}