{
  "opencollection": "1.0.0",
  "info": {
    "name": "Keystone Accounts API",
    "version": "v12"
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all accounts associated with the authenticated identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.autoenrolment.co.uk/accounts",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://id.sandbox.autoenrolment.co.uk/oauth/authorize",
              "accessTokenUrl": "https://id.sandbox.autoenrolment.co.uk/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List all accounts associated with the authenticated identity"
        }
      ]
    }
  ],
  "bundled": true
}